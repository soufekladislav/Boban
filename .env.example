SECRET_KEY=change-me-in-production
APP_NAME=Web Booster
APP_URL=https://webbooster.freshcrackers.cz
DATABASE_PATH=webbooster.db
# Production DB (recommended from 0.4.0). If empty, app keeps using SQLite.
# URL-encode special characters in username/password.
DATABASE_URL=

# Fresh AI Engine – Boban chat + AI návrhy SEO metadat + Fresh Key Propojení
# Stejný app-specific Engine klíč používá Boban pro synchronizaci projektu, členů a SSO do Fresh Key.
FRESH_AI_ENGINE_URL=https://aiengine.freshcrackers.cz
FRESH_AI_ENGINE_API_KEY=
AI_BATCH_LIMIT=20
# Search Console: počet detailních dotazů / query+page řádků v jednom 28denním snapshotu.
GSC_QUERY_LIMIT=750
GSC_QUERY_PAGE_LIMIT=1500
# Kolik posledních snapshotů každého analytického konektoru držet v DB.
SOURCE_SNAPSHOT_KEEP=90
# Max. čekání na jednu write operaci Fresh Core; hromadné provedení běží přes frontu.
CORE_WRITE_TIMEOUT=18
# Worker se považuje za neaktivní, pokud se neozve déle než tento počet sekund.
WORKER_STALE_SECONDS=180
WORKER_POLL_SECONDS=10

# Google OAuth – 0.7.3 používá Search Console + GA4 + Google Tag Manager read-only.
# V Google Cloud povol Search Console API, Google Analytics Data API, Google Analytics Admin API a Tag Manager API.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://webbooster.freshcrackers.cz/connectors/google/callback

# PageSpeed Insights + Chrome UX Report (API key, ne OAuth).
# Povol PageSpeed Insights API a Chrome UX Report API.
PAGESPEED_API_KEY=
# Alternativně můžeš použít společný GOOGLE_API_KEY; PAGESPEED_API_KEY má přednost.
GOOGLE_API_KEY=

# Vývojový read-only manifest Web Boosteru
DEVELOPER_MANIFEST_TOKEN=

HTTP_TIMEOUT=8
CRAWL_LIMIT=25
WEBBOOSTER_USER_AGENT=Fresh-Web-Booster/0.8.0 (+https://webbooster.freshcrackers.cz)

# Branding – lze později změnit bez zásahu do šablon
BOBAN_IMAGE_URL=https://www.freshcrackers.cz/wp-content/uploads/2026/08/boban.png
FRESH_LOGO_URL=https://www.freshcrackers.cz/wp-content/uploads/2023/10/Fresh-Crackers-Logo.png

# Budoucí konektory – zatím nepoužíváno aplikací
BING_CLIENT_ID=
BING_CLIENT_SECRET=
BING_REDIRECT_URI=https://webbooster.freshcrackers.cz/connectors/bing/callback
INDEXNOW_KEY=

# Legacy 0.1.x compatibility only; nové projekty používají Fresh Core Manifest URL.
FRESH_CORE_SHARED_SECRET=

# Systémový administrátor Web Boosteru
WEBBOOSTER_ADMIN_EMAIL=soufek@freshcrackers.cz
